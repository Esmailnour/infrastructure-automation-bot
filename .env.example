# Telegram
TELEGRAM_BOT_TOKEN=replace_with_a_new_token
ADMIN_USER_IDS=123456789
AUTHORIZED_USER_IDS=123456789

# Inventory
INVENTORY_FILE=sample_data/sample_inventory.xlsx
LOG_FILE=runtime/bot.log
WHITELIST_FILE=runtime/whitelist.json

# Safety defaults
SAFE_MODE=true
ALLOW_CHAT_CREDENTIALS=false
RETURN_GENERATED_SECRETS_IN_CHAT=false

# Redfish
REDFISH_VERIFY_TLS=true
REDFISH_TIMEOUT_SECONDS=12
TEAM_USERNAME=
TEAM_PASSWORD=
SUPPORT_ACCOUNT_USERNAME=support
SUPPORT_ACCOUNT_PASSWORD=
# Comma-separated and intentionally blank in the public repository.
REDFISH_PASSWORD_CANDIDATES=
# New password to use only when explicitly running a configured rotation workflow.
REDFISH_NEW_PASSWORD=

# SSH / bootstrap
# Leave blank to use normal AsyncSSH known_hosts behavior.
# Use "none" only in an isolated lab where host-key verification is intentionally disabled.
SSH_KNOWN_HOSTS=
SSH_CONNECT_TIMEOUT_SECONDS=30
SSH_LOGIN_TIMEOUT_SECONDS=30
BOOTSTRAP_USERNAME=
BOOTSTRAP_PASSWORD=
# Preferred public-safe mode: configure the new root password outside Telegram.
BOOTSTRAP_NEW_ROOT_PASSWORD=
CENTOS_BOOTSTRAP_USERNAME=root
CENTOS_BOOTSTRAP_PASSWORD=
ROOT_USERNAME=root

# Transfer tuning
TOTAL_BANDWIDTH_GBPS=10
MAX_PARALLEL_SESSIONS=20
TRANSFER_CONCURRENCY=10
PARALLEL_SPLIT_THRESHOLD_GB=1000
SCREEN_THRESHOLD_GB=50
TRANSFER_SPLIT_MAX_DEPTH=8
